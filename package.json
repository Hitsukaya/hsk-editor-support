{
  "name": "hsk-language",
  "displayName": "HSK Language",
  "description": "Syntax highlighting and snippets for HSK",
  "version": "0.0.1",
  "publisher": "hitsukaya",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hsk",
        "aliases": [
          "HSK",
          "hsk"
        ],
        "extensions": [
          ".hsk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hsk",
        "scopeName": "source.hsk",
        "path": "./syntaxes/hsk.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "hsk",
        "path": "./snippets/hsk.json"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0"
  }
}
