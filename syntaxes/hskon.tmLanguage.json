{
  "name": "HSKON",
  "scopeName": "source.hskon",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#null" },
    { "include": "#object" },
    { "include": "#array" },
    { "include": "#key-value" }
  ],

  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.hskon",
          "match": "#.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hskon",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hskon",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hskon",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.hskon",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.hskon",
          "match": "\\b(true|false)\\b"
        }
      ]
    },

    "null": {
      "patterns": [
        {
          "name": "constant.language.null.hskon",
          "match": "\\bnull\\b"
        }
      ]
    },

    "object": {
      "patterns": [
        {
          "name": "meta.object.hskon",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.block.begin.hskon" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.hskon" }
          },
          "patterns": [
            { "include": "#key-value" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#booleans" },
            { "include": "#null" },
            { "include": "#object" },
            { "include": "#array" }
          ]
        }
      ]
    },

    "array": {
      "patterns": [
        {
          "name": "meta.array.hskon",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.array.begin.hskon" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.array.end.hskon" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#booleans" },
            { "include": "#null" },
            { "include": "#object" }
          ]
        }
      ]
    },

    "key-value": {
      "patterns": [
        {
          "name": "meta.key-value.hskon",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*",
          "captures": {
            "1": { "name": "variable.other.key.hskon" },
            "2": { "name": "keyword.operator.assignment.hskon" }
          }
        }
      ]
    }
  }
}