{
  "name": "HSK",
  "scopeName": "source.hsk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },

    { "include": "#metadata-declaration" },
    { "include": "#system-declaration" },
    { "include": "#unit-declaration" },
    { "include": "#command-declaration" },
    { "include": "#function-declaration" },
    { "include": "#class-declaration" },
    { "include": "#struct-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#sequence-declaration" },
    { "include": "#stage-declaration" },
    { "include": "#typed-block-declaration" },

    { "include": "#kumo-declaration" },
    { "include": "#route-declaration" },

    { "include": "#load-statement" },
    { "include": "#report-statement" },
    { "include": "#bind-statement" },
    { "include": "#require-statement" },
    { "include": "#shell-statement" },
    { "include": "#inspect-statement" },
    { "include": "#exec-statement" },

    { "include": "#variable-declaration" },
    { "include": "#function-calls" },
    { "include": "#enum-access-expression" },
    { "include": "#object-access-expression" },
    { "include": "#path-expression" },

    { "include": "#types" },
    { "include": "#kumo-keywords" },
    { "include": "#kumo-view-keywords" },
    { "include": "#hss-style-keywords" },
    { "include": "#event-keywords" },
    { "include": "#asset-keywords" },
    { "include": "#keywords-structure" },
    { "include": "#keywords-control" },
    { "include": "#keywords-builtins" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.hsk",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.hsk",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hsk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hsk",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.size.hsk",
          "match": "\\b\\d+(KB|MB|GB|TB|ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.float.hsk",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.hsk",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.hsk",
          "match": "\\b(void|string|int|long|long_long|bool|state|float|double|vector|map)\\b"
        }
      ]
    },

    "keywords-structure": {
      "patterns": [
        {
          "name": "keyword.other.structure.hsk",
          "match": "\\b(include|metadata|system|unit|command|function|stage|sequence|block|define|enum|struct|class|const|static|public|private|protected|this|new|use|style)\\b"
        }
      ]
    },

    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.hsk",
          "match": "\\b(if|else|while|for|switch|case|default|break|continue|return|try|catch|throw|and|or|not)\\b"
        }
      ]
    },

    "keywords-builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.hsk",
          "match": "\\b(shell|report|require|privilege|in|bind|from|contains|inspect|exec|load|into|len|title|description|version|author|value)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hsk",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.language.report.hsk",
          "match": "\\b(ok|warn|fail|info)\\b"
        },
        {
          "name": "constant.language.require.hsk",
          "match": "\\b(root|privilege)\\b"
        },
        {
          "name": "constant.language.http-method.hsk",
          "match": "\\b(GET|POST|PUT|DELETE|PATCH)\\b"
        }
      ]
    },

    "kumo-keywords": {
      "patterns": [
        {
          "name": "keyword.other.kumo.hsk",
          "match": "\\b(kumo|server|route|method|redirect|cache|runtime|memory|ram|cpu|ssd|nvme|disk|tmp|log|logs|reload|live|daemon|workers|workers_min|workers_max|pid_file|socket|host|hostname|port|reverse_proxy|proxy_pass|upstream|queue|event_queue|kqueue|epoll|poll|select|auto|adaptive|edge|origin|cdn|prewarm|invalidate|versioning|sync|l1|l2|l3|l4|MISS|HIT)\\b"
        }
      ]
    },

    "kumo-view-keywords": {
      "patterns": [
        {
          "name": "keyword.other.kumo.view.hsk",
          "match": "\\b(hsk_kumo_view|meta|canonical|og|page|header|footer|section|nav|list|item|text|link|image|script|form|field|input|button|label|placeholder)\\b"
        }
      ]
    },

    "hss-style-keywords": {
      "patterns": [
        {
          "name": "support.type.property.hss.hsk",
          "match": "\\b(select|background|color|font_size|font_weight|font_family|padding|margin|width|height|border|border_radius|layout|gap|align)\\b"
        }
      ]
    },

    "event-keywords": {
      "patterns": [
        {
          "name": "keyword.other.event.hsk",
          "match": "\\b(on|click|submit|change|set)\\b"
        }
      ]
    },

    "asset-keywords": {
      "patterns": [
        {
          "name": "keyword.other.asset.hsk",
          "match": "\\b(to|external|target|rel|source|alt|loading|decoding)\\b"
        }
      ]
    },

    "metadata-declaration": {
      "patterns": [
        {
          "name": "meta.metadata.declaration.hsk",
          "match": "\\b(metadata)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.namespace.hsk" }
          }
        }
      ]
    },

    "system-declaration": {
      "patterns": [
        {
          "name": "meta.system.declaration.hsk",
          "match": "\\b(system)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.namespace.hsk" }
          }
        }
      ]
    },

    "unit-declaration": {
      "patterns": [
        {
          "name": "meta.unit.declaration.hsk",
          "match": "\\b(unit)\\s+(command|function|service)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "storage.type.hsk" },
            "3": { "name": "entity.name.type.hsk" }
          }
        }
      ]
    },

    "command-declaration": {
      "patterns": [
        {
          "name": "meta.command.declaration.hsk",
          "match": "\\b(command)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.function.hsk" }
          }
        }
      ]
    },

    "function-declaration": {
      "patterns": [
        {
          "name": "meta.function.declaration.hsk",
          "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.function.hsk" },
            "3": { "name": "punctuation.section.group.begin.hsk" }
          }
        }
      ]
    },

    "class-declaration": {
      "patterns": [
        {
          "name": "meta.class.declaration.hsk",
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.class.hsk" }
          }
        }
      ]
    },

    "struct-declaration": {
      "patterns": [
        {
          "name": "meta.struct.declaration.hsk",
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.struct.hsk" }
          }
        }
      ]
    },

    "enum-declaration": {
      "patterns": [
        {
          "name": "meta.enum.declaration.hsk",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.type.enum.hsk" }
          }
        }
      ]
    },

    "sequence-declaration": {
      "patterns": [
        {
          "name": "meta.sequence.declaration.hsk",
          "match": "\\b(sequence)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.type.hsk" }
          }
        }
      ]
    },

    "stage-declaration": {
      "patterns": [
        {
          "name": "meta.stage.declaration.hsk",
          "match": "\\b(stage)\\s+(\\d+)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "constant.numeric.integer.hsk" }
          }
        }
      ]
    },

    "typed-block-declaration": {
      "patterns": [
        {
          "name": "meta.block.declaration.hsk",
          "match": "\\b(block)\\s+(command|string|int|long|long_long|bool|state|float|double|vector|map)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "storage.type.hsk" },
            "3": { "name": "entity.name.type.hsk" }
          }
        }
      ]
    },

    "kumo-declaration": {
      "patterns": [
        {
          "name": "meta.kumo.server.declaration.hsk",
          "match": "\\b(kumo)\\s+(server)\\b",
          "captures": {
            "1": { "name": "keyword.other.kumo.hsk" },
            "2": { "name": "entity.name.type.kumo.hsk" }
          }
        }
      ]
    },

    "route-declaration": {
      "patterns": [
        {
          "name": "meta.kumo.route.declaration.hsk",
          "match": "\\b(route)\\s+(\"[^\"]*\")\\s+(method)\\s+(GET|POST|PUT|DELETE|PATCH)\\b",
          "captures": {
            "1": { "name": "keyword.other.kumo.hsk" },
            "2": { "name": "string.quoted.double.hsk" },
            "3": { "name": "keyword.other.kumo.hsk" },
            "4": { "name": "constant.language.http-method.hsk" }
          }
        }
      ]
    },

    "load-statement": {
      "patterns": [
        {
          "name": "meta.load.statement.hsk",
          "match": "\\b(load)\\s+(\"[^\"]+\")\\s+(into)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "string.quoted.double.hsk" },
            "3": { "name": "support.function.builtin.hsk" },
            "4": { "name": "variable.other.definition.hsk" }
          }
        }
      ]
    },

    "report-statement": {
      "patterns": [
        {
          "name": "meta.report.statement.hsk",
          "match": "\\b(report)\\s+([A-Za-z_][A-Za-z0-9_]*)\\.(ok|warn|fail|info)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "entity.name.type.enum.hsk" },
            "3": { "name": "constant.other.enum.value.hsk" }
          }
        },
        {
          "name": "meta.report.statement.legacy.hsk",
          "match": "\\b(report)\\s+(ok|warn|fail|info)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "constant.language.report.hsk" }
          }
        }
      ]
    },

    "bind-statement": {
      "patterns": [
        {
          "name": "meta.bind.statement.hsk",
          "match": "\\b(bind)\\s+(bool|int|long|long_long|float|double|string|state)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(from)\\s+(\"[^\"]*\")\\s+(contains)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "storage.type.hsk" },
            "3": { "name": "variable.other.definition.hsk" },
            "4": { "name": "support.function.builtin.hsk" },
            "5": { "name": "string.quoted.double.hsk" },
            "6": { "name": "support.function.builtin.hsk" },
            "7": { "name": "string.quoted.double.hsk" }
          }
        },
        {
          "name": "meta.bind.statement.simple.hsk",
          "match": "\\b(bind)\\s+(bool|int|long|long_long|float|double|string|state)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "storage.type.hsk" },
            "3": { "name": "variable.other.definition.hsk" }
          }
        }
      ]
    },

    "require-statement": {
      "patterns": [
        {
          "name": "meta.require.statement.hsk",
          "match": "\\b(require)\\s+(root|privilege)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "constant.language.require.hsk" }
          }
        }
      ]
    },

    "shell-statement": {
      "patterns": [
        {
          "name": "meta.shell.statement.hsk",
          "match": "\\b(shell)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" }
          }
        }
      ]
    },

    "inspect-statement": {
      "patterns": [
        {
          "name": "meta.inspect.statement.hsk",
          "match": "\\b(inspect)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "entity.name.type.hsk" }
          }
        }
      ]
    },

    "exec-statement": {
      "patterns": [
        {
          "name": "meta.exec.statement.hsk",
          "match": "\\b(exec)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "entity.name.type.hsk" }
          }
        }
      ]
    },

    "variable-declaration": {
      "patterns": [
        {
          "name": "meta.variable.declaration.hsk",
          "match": "\\b(bool|int|long|long_long|float|double|string|state|vector|map)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.hsk" },
            "2": { "name": "variable.other.definition.hsk" }
          }
        }
      ]
    },

    "enum-access-expression": {
      "patterns": [
        {
          "name": "meta.enum.access.hsk",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.(ok|warn|fail|info)\\b",
          "captures": {
            "1": { "name": "entity.name.type.enum.hsk" },
            "2": { "name": "constant.other.enum.value.hsk" }
          }
        }
      ]
    },

    "object-access-expression": {
      "patterns": [
        {
          "name": "meta.object.access.hsk",
          "match": "\\b(this|config|data|html|app|server|runtime|cache|kumo)\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.other.object.hsk" },
            "2": { "name": "variable.other.property.hsk" }
          }
        }
      ]
    },

    "path-expression": {
      "patterns": [
        {
          "name": "meta.path.expression.hsk",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\.[A-Za-z_][A-Za-z0-9_]*|\\.\\d+)+\\b",
          "captures": {
            "1": { "name": "variable.other.object.hsk" }
          }
        }
      ]
    },

    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.hsk",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.hsk",
          "match": "==|!=|>=|<=|&&|\\|\\||\\+\\+|--|->|=|>|<|\\+|-|\\*|/|%|!|:|\\."
        }
      ]
    }
  }
}