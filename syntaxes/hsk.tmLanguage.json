{
  "name": "HSK",
  "scopeName": "source.hsk",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },

    { "include": "#unit-command-declaration" },
    { "include": "#system-declaration" },
    { "include": "#metadata-declaration" },
    { "include": "#sequence-declaration" },
    { "include": "#stage-declaration" },
    { "include": "#function-declaration" },
    { "include": "#command-run-declaration" },
    { "include": "#typed-block-declaration" },

    { "include": "#report-statement" },
    { "include": "#bind-statement" },
    { "include": "#require-statement" },
    { "include": "#shell-statement" },
    { "include": "#inspect-statement" },
    { "include": "#exec-statement" },
    { "include": "#variable-declaration" },
    { "include": "#path-expression" },

    { "include": "#types" },
    { "include": "#keywords-structure" },
    { "include": "#keywords-control" },
    { "include": "#keywords-builtins" },
    { "include": "#constants" },
    { "include": "#function-calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hsk",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hsk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hsk",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hsk",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.hsk",
          "match": "\\b(void|bool|int|long|long_long|string|state)\\b"
        }
      ]
    },

    "keywords-structure": {
      "patterns": [
        {
          "name": "keyword.other.structure.hsk",
          "match": "\\b(system|unit|command|function|stage|sequence|metadata|include|block)\\b"
        }
      ]
    },

    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.hsk",
          "match": "\\b(if|else|while|for|switch|case|default|break|continue|return)\\b"
        }
      ]
    },

    "keywords-builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.hsk",
          "match": "\\b(bind|from|contains|inspect|exec|report|require|in|title|description|version|author|value|shell)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hsk",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.report.hsk",
          "match": "\\b(ok|warn|fail|info)\\b"
        },
        {
          "name": "constant.language.require.hsk",
          "match": "\\b(root|privilege)\\b"
        }
      ]
    },

    "unit-command-declaration": {
      "patterns": [
        {
          "name": "meta.unit.command.hsk",
          "match": "\\b(unit)\\s+(command|function|service)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "keyword.other.structure.hsk" },
            "3": { "name": "entity.name.type.hsk" }
          }
        }
      ]
    },

    "system-declaration": {
      "patterns": [
        {
          "name": "meta.system.declaration.hsk",
          "match": "\\b(system)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.namespace.hsk" }
          }
        }
      ]
    },

    "metadata-declaration": {
      "patterns": [
        {
          "name": "meta.metadata.declaration.hsk",
          "match": "\\b(metadata)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.namespace.hsk" }
          }
        }
      ]
    },

    "sequence-declaration": {
      "patterns": [
        {
          "name": "meta.sequence.declaration.hsk",
          "match": "\\b(sequence)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.type.hsk" }
          }
        }
      ]
    },

    "stage-declaration": {
      "patterns": [
        {
          "name": "meta.stage.declaration.hsk",
          "match": "\\b(stage)\\s+(\\d+)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "constant.numeric.hsk" }
          }
        }
      ]
    },

    "function-declaration": {
      "patterns": [
        {
          "name": "meta.function.declaration.hsk",
          "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.function.hsk" }
          }
        }
      ]
    },

    "command-run-declaration": {
      "patterns": [
        {
          "name": "meta.command.run.hsk",
          "match": "\\b(command)\\s+(run)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "entity.name.function.special.hsk" }
          }
        }
      ]
    },

    "typed-block-declaration": {
      "patterns": [
        {
          "name": "meta.block.declaration.hsk",
          "match": "\\b(block)\\s+(state|string|int|long|long_long|bool|command)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.structure.hsk" },
            "2": { "name": "storage.type.hsk" },
            "3": { "name": "entity.name.type.hsk" }
          }
        }
      ]
    },

    "report-statement": {
      "patterns": [
        {
          "name": "meta.report.statement.hsk",
          "match": "\\b(report)\\s+(ok|warn|fail|info)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "constant.language.report.hsk" }
          }
        }
      ]
    },

    "bind-statement": {
      "patterns": [
        {
          "name": "meta.bind.statement.hsk",
          "match": "\\b(bind)\\s+(bool|int|long|long_long|string)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "storage.type.hsk" },
            "3": { "name": "variable.other.hsk" }
          }
        }
      ]
    },

    "require-statement": {
      "patterns": [
        {
          "name": "meta.require.statement.hsk",
          "match": "\\b(require)\\s+(root|privilege)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "constant.language.require.hsk" }
          }
        }
      ]
    },

    "shell-statement": {
      "patterns": [
        {
          "name": "meta.shell.statement.hsk",
          "match": "\\b(shell)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" }
          }
        }
      ]
    },

    "inspect-statement": {
      "patterns": [
        {
          "name": "meta.inspect.statement.hsk",
          "match": "\\b(inspect)\\s+(shell)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "storage.type.hsk" }
          }
        }
      ]
    },

    "exec-statement": {
      "patterns": [
        {
          "name": "meta.exec.statement.hsk",
          "match": "\\b(exec)\\s+(shell)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.hsk" },
            "2": { "name": "storage.type.hsk" }
          }
        }
      ]
    },

    "variable-declaration": {
      "patterns": [
        {
          "name": "meta.variable.declaration.hsk",
          "match": "\\b(bool|int|long|long_long|string)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.hsk" },
            "2": { "name": "variable.other.definition.hsk" }
          }
        }
      ]
    },

    "path-expression": {
      "patterns": [
        {
          "name": "meta.path.expression.hsk",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\.[A-Za-z_][A-Za-z0-9_]*)+\\b",
          "captures": {
            "1": { "name": "variable.other.object.hsk" }
          }
        },
        {
          "name": "keyword.operator.hsk",
          "match": "\\."
        }
      ]
    },

    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.hsk",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.hsk",
          "match": "==|!=|>=|<=|&&|\\|\\||=|>|<|\\+|-|\\*|/|%|\\."
        }
      ]
    }
  }
}