{
  "name": "HCONF",
  "scopeName": "source.hconf",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#null" },
    { "include": "#section" },
    { "include": "#key-value" },
    { "include": "#identifiers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.hconf",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.hconf",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hconf",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hconf",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.size.hconf",
          "match": "\\b\\d+(KB|MB|GB|TB|ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.float.hconf",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.hconf",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.hconf",
          "match": "\\b(true|false)\\b"
        }
      ]
    },

    "null": {
      "patterns": [
        {
          "name": "constant.language.null.hconf",
          "match": "\\b(null)\\b"
        }
      ]
    },

    "section": {
      "patterns": [
        {
          "name": "meta.section.hconf",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_\\.\\-]*)\\s*(\\{)",
          "captures": {
            "1": { "name": "entity.name.section.hconf" },
            "2": { "name": "punctuation.definition.block.begin.hconf" }
          }
        }
      ]
    },

    "key-value": {
      "patterns": [
        {
          "name": "meta.key-value.hconf",
          "match": "\\b([A-Za-z_][A-Za-z0-9_\\-]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.key.hconf" },
            "2": { "name": "keyword.operator.assignment.hconf" }
          }
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.hconf",
          "match": "\\b[A-Za-z_][A-Za-z0-9_\\-]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.hconf",
          "match": "="
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.hconf",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.hconf",
          "match": ";"
        },
        {
          "name": "punctuation.definition.block.begin.hconf",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.block.end.hconf",
          "match": "\\}"
        }
      ]
    }
  }
}