metadata {
    title "TEST IS HSK LANGUAGE"
    description "This is a test HSK language!"
    version "1.0.0"
    author "Hitsukaya"
}


unit command ssh_status {
    command run {
        bind bool ssh_ok from "service sshd onestatus" contains "is running"

        if ssh_ok {
            report ok "SSH is running"
        } else {
            report fail "SSH is down"
        }
    }
}