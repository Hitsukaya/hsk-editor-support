syntax "hskon" "\.hskon$"

# Identifiers: object names and keys
color brightcyan "\<[[:alpha:]_][[:alnum:]_]*\>"

# Numbers
color yellow "\<[0-9]+(\.[0-9]+)?\>"

# Boolean values
color brightred "\<(true|false)\>"

# Assignment and separators
color white "[=,]"

# Objects
color brightblue "[{}]"

# Strings
color green "\"([^\"\\]|\\.)*\""