{
  "shebang": {
    "prefix": "shebang",
    "body": ["#!/usr/local/bin/hsk"],
    "description": "HSK shebang"
  },

  "load hconf": {
    "prefix": "loadhconf",
    "body": ["load \"${1:app.hconf}\" into ${2:config};"],
    "description": "Load HCONF into variable"
  },

  "load hskon": {
    "prefix": "loadhskon",
    "body": ["load \"${1:app.hskon}\" into ${2:data};"],
    "description": "Load HSKON into variable"
  },

  "load html hskon": {
    "prefix": "loadhtml",
    "body": ["load \"${1:html.hskon}\" into ${2:html};"],
    "description": "Load html.hskon into html variable"
  },

  "include": {
    "prefix": "include",
    "body": ["include \"${1:path.hsk}\";"],
    "description": "HSK include statement"
  },

  "metadata": {
    "prefix": "meta",
    "body": [
      "metadata ${1:app} {",
      "    title \"${2:Title}\"",
      "    description \"${3:Description}\"",
      "    version \"${4:0.1.0}\"",
      "    author \"${5:Author}\"",
      "}"
    ],
    "description": "HSK metadata block"
  },

  "system": {
    "prefix": "system",
    "body": [
      "system ${1:name} {",
      "    ${2:# code}",
      "}"
    ],
    "description": "HSK system block"
  },

  "kumo app": {
    "prefix": "kumoapp",
    "body": [
      "#!/usr/local/bin/hsk",
      "",
      "load \"${1:app.hconf}\" into config;",
      "load \"${2:app.hskon}\" into data;",
      "load \"${3:html.hskon}\" into html;",
      "",
      "system ${4:web_app} {",
      "    kumo server {",
      "        host = config.kumo.host;",
      "        port = config.kumo.port;",
      "        daemon = config.kumo.daemon;",
      "",
      "        route \"/\" method GET {",
      "            return html.pages.index;",
      "        }",
      "    }",
      "}"
    ],
    "description": "HSK Kumo app template"
  },

  "kumo server": {
    "prefix": "kumoserver",
    "body": [
      "kumo server {",
      "    host = ${1:config.kumo.host};",
      "    port = ${2:config.kumo.port};",
      "    daemon = ${3:config.kumo.daemon};",
      "",
      "    ${4:# routes}",
      "}"
    ],
    "description": "Kumo server block"
  },

  "kumo route get": {
    "prefix": "routeget",
    "body": [
      "route \"${1:/}\" method GET {",
      "    return ${2:html.pages.index};",
      "}"
    ],
    "description": "Kumo GET route"
  },

  "kumo route post": {
    "prefix": "routepost",
    "body": [
      "route \"${1:/submit}\" method POST {",
      "    ${2:# code}",
      "}"
    ],
    "description": "Kumo POST route"
  },

  "kumo redirect": {
    "prefix": "redirect",
    "body": [
      "redirect \"${1:/old}\" to \"${2:/new}\";"
    ],
    "description": "Kumo redirect"
  },

  "kumo cache config": {
    "prefix": "kumocache",
    "body": [
      "cache {",
      "    l1 = config.kumo.cache.l1;",
      "    l2 = config.kumo.cache.l2;",
      "    l3 = config.kumo.cache.l3;",
      "    l4 = config.kumo.cache.l4;",
      "}"
    ],
    "description": "Kumo cache L1-L4 block"
  },

  "event queue config": {
    "prefix": "eventqueue",
    "body": [
      "event_queue = ${1:auto};"
    ],
    "description": "Kumo event queue config"
  },

  "unit command": {
    "prefix": "unitcmd",
    "body": [
      "unit command ${1:name} {",
      "    command ${2:run} {",
      "        ${3:# code}",
      "    }",
      "}"
    ],
    "description": "HSK unit command template"
  },

  "unit function": {
    "prefix": "unitfn",
    "body": [
      "unit function ${1:name} {",
      "    ${2:# code}",
      "}"
    ],
    "description": "HSK unit function template"
  },

  "unit service": {
    "prefix": "unitsvc",
    "body": [
      "unit service ${1:name} {",
      "    ${2:# code}",
      "}"
    ],
    "description": "HSK unit service template"
  },

  "command": {
    "prefix": "cmd",
    "body": [
      "command ${1:run} {",
      "    ${2:# code}",
      "}"
    ],
    "description": "HSK command block"
  },

  "function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2}): ${3:void} {",
      "    ${4:# code}",
      "}"
    ],
    "description": "HSK function template"
  },

  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    private string ${2:name};",
      "",
      "    public function ${3:set_name}(string value): void {",
      "        this.${2:name} = value;",
      "    }",
      "}"
    ],
    "description": "HSK class template"
  },

  "enum report level": {
    "prefix": "enumreport",
    "body": [
      "enum report_level {",
      "    ok = 0,",
      "    warn = 1,",
      "    fail = 2,",
      "    info = 3",
      "}"
    ],
    "description": "HSK report_level enum"
  },

  "return": {
    "prefix": "ret",
    "body": ["return ${1:value};"],
    "description": "HSK return statement"
  },

  "if else": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${2:# code}",
      "} else {",
      "    ${3:# code}",
      "}"
    ],
    "description": "HSK if/else template"
  },

  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    ${2:# code}",
      "}"
    ],
    "description": "HSK while template"
  },

  "for": {
    "prefix": "for",
    "body": [
      "for (${1:int i = 0}; ${2:i < 10}; ${3:i = i + 1}) {",
      "    ${4:# code}",
      "}"
    ],
    "description": "HSK for loop template"
  },

  "switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:expr}) {",
      "    case ${2:value} {",
      "        ${3:# code}",
      "    }",
      "    default {",
      "        ${4:# code}",
      "    }",
      "}"
    ],
    "description": "HSK switch template"
  },

  "try catch": {
    "prefix": "try",
    "body": [
      "try {",
      "    ${1:# code}",
      "} catch {",
      "    ${2:# error handling}",
      "}"
    ],
    "description": "HSK try/catch"
  },

  "throw": {
    "prefix": "throw",
    "body": ["throw \"${1:error message}\";"],
    "description": "HSK throw statement"
  },

  "block string": {
    "prefix": "bstr",
    "body": [
      "block string ${1:name} {",
      "    value \"${2:text}\"",
      "}"
    ],
    "description": "HSK string block"
  },

  "block int": {
    "prefix": "bint",
    "body": [
      "block int ${1:name} {",
      "    value ${2:0}",
      "}"
    ],
    "description": "HSK int block"
  },

  "block long": {
    "prefix": "blong",
    "body": [
      "block long ${1:name} {",
      "    value ${2:0}",
      "}"
    ],
    "description": "HSK long block"
  },

  "block long_long": {
    "prefix": "bll",
    "body": [
      "block long_long ${1:name} {",
      "    value ${2:0}",
      "}"
    ],
    "description": "HSK long_long block"
  },

  "block bool": {
    "prefix": "bbool",
    "body": [
      "block bool ${1:name} {",
      "    value ${2:true}",
      "}"
    ],
    "description": "HSK bool block"
  },

  "block float": {
    "prefix": "bfloat",
    "body": [
      "block float ${1:name} {",
      "    value ${2:0.0}",
      "}"
    ],
    "description": "HSK float block"
  },

  "block double": {
    "prefix": "bdouble",
    "body": [
      "block double ${1:name} {",
      "    value ${2:0.0}",
      "}"
    ],
    "description": "HSK double block"
  },

  "bind bool": {
    "prefix": "bindb",
    "body": ["bind bool ${1:name} from \"${2:command}\" contains \"${3:text}\";"],
    "description": "HSK bind bool"
  },

  "bind string": {
    "prefix": "binds",
    "body": ["bind string ${1:name} from \"${2:command}\" contains \"${3:text}\";"],
    "description": "HSK bind string"
  },

  "report ok": {
    "prefix": "rok",
    "body": ["report report_level.ok \"${1:message}\";"],
    "description": "HSK report ok"
  },

  "report warn": {
    "prefix": "rwarn",
    "body": ["report report_level.warn \"${1:message}\";"],
    "description": "HSK report warn"
  },

  "report fail": {
    "prefix": "rfail",
    "body": ["report report_level.fail \"${1:message}\";"],
    "description": "HSK report fail"
  },

  "report info": {
    "prefix": "rinfo",
    "body": ["report report_level.info \"${1:message}\";"],
    "description": "HSK report info"
  },

  "shell": {
    "prefix": "shell",
    "body": ["shell \"${1:command}\";"],
    "description": "HSK shell statement"
  },

  "require root": {
    "prefix": "reqroot",
    "body": ["require root;"],
    "description": "HSK require root"
  },

  "bool variable": {
    "prefix": "vbool",
    "body": ["bool ${1:name} = ${2:true};"],
    "description": "HSK bool variable"
  },

  "int variable": {
    "prefix": "vint",
    "body": ["int ${1:name} = ${2:0};"],
    "description": "HSK int variable"
  },

  "long_long variable": {
    "prefix": "vll",
    "body": ["long_long ${1:name} = ${2:0};"],
    "description": "HSK long_long variable"
  },

  "float variable": {
    "prefix": "vfloat",
    "body": ["float ${1:name} = ${2:0.0};"],
    "description": "HSK float variable"
  },

  "double variable": {
    "prefix": "vdouble",
    "body": ["double ${1:name} = ${2:0.0};"],
    "description": "HSK double variable"
  },

  "string variable": {
    "prefix": "vstr",
    "body": ["string ${1:name} = \"${2:text}\";"],
    "description": "HSK string variable"
  },

  "assignment": {
    "prefix": "set",
    "body": ["${1:name} = ${2:value};"],
    "description": "HSK assignment"
  }
}